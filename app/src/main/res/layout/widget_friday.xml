<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_friday_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Title & Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tv_friday_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🕌 يوم الجمعة المبارك"
            android:textColor="#F3C649"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tv_friday_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الجمعة"
            android:textColor="#B2DFDB"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Center Status / Message -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="6dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_tv_friday_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="📖 قراءة سورة الكهف والصلاة على النبي ﷺ"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tv_salawat_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_widget_prayer_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="الصلاة على النبي: 0 ﷺ"
            android:textColor="#F3C649"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_btn_read_kahf"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="سورة الكهف 📖"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_btn_open_friday"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="قسم الجمعة 🕌"
            android:textColor="#F3C649"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
